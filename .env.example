# All variables are optional. Without them the Co-Pilot uses its deterministic fallback.
# Copy to .env.local to enable a live LLM for phrasing and intent understanding.

# "openai" enables the OpenAI-compatible adapter; anything else (or empty) uses the fallback.
LLM_PROVIDER=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (Azure OpenAI proxy, local gateway, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
